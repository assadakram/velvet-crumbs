# Gmail SMTP Configuration for Nodemailer Order Submission
# Replace these values with your actual Gmail account and App Password
# Note: GMAIL_PASS should be a 16-character App Password, not your standard Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_USER=example@gmail.com
GMAIL_PASS=your_gmail_app_password

# The email address that will receive the order notifications
RECEIVER_EMAIL=recipient-email@domain.com

# WhatsApp redirect number (without + prefix, e.g. 358xxxxxxxxxx)
NEXT_PUBLIC_WHATSAPP_NUMBER=35xxxxxxxxxx

# Admin Dashboard & Preorder Settings Authentication
ADMIN_SECRET=your_secure_admin_secret_key

# Firebase Admin SDK Configuration (Cloud Firestore persistence)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkq...\n-----END PRIVATE KEY-----\n"


